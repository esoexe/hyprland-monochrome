@import "theme.rasi"

/* Logout / power menu (Super + ESCAPE, Super + `) and the "are you sure?"
   prompts. Also used for confirmation dialogs from other scripts. */

configuration {
    show-icons: false;
    matching: "fuzzy";
    sort: false;
}

window {
    width: 340px;
    padding: 12px;
    border-radius: 16px;
}

listview {
    lines: 6;
    columns: 1;
    spacing: 6px;
}

element {
    padding: 12px 16px;
    spacing: 14px;
    font: "JetBrainsMono Nerd Font 13";
    border-radius: 11px;
}

prompt {
    text-color: @accent;
    font: "JetBrainsMono Nerd Font 14";
}

entry {
    placeholder: "choose an action…";
    font: "JetBrainsMono Nerd Font 13";
}
