@import "theme.rasi"

/* App launcher / window switcher / run (Super + D, Super + SHIFT + D)
   Text-only by default to keep the look strictly monochrome.
   Want app icons back? Uncomment the two lines below. */

configuration {
    show-icons: false;
    /* show-icons: true; */
    /* icon-theme: "Papirus-Dark"; */
    drun-display-format: "{name}";
    window-format: "{t:55}  ·  {c}";
    matching: "fuzzy";
}

window {
    width: 480px;
    padding: 10px;
}

listview {
    lines: 9;
    columns: 1;
}

element {
    padding: 9px 14px;
}

element-text {
    font: "JetBrainsMono Nerd Font 12";
}

prompt {
    text-color: @accent;
    font: "JetBrainsMono Nerd Font 13";
}

entry {
    placeholder: "search apps…";
}
