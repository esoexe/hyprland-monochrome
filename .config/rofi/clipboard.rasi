@import "theme.rasi"

/* Clipboard history (Super + V)
   Enter copies · Delete removes the entry · Super + Delete wipes everything. */

configuration {
    show-icons: true;
    icon-theme: "Papirus-Dark";
    matching: "fuzzy";
    sort: false;
}

window {
    width: 620px;
    padding: 10px;
}

listview {
    lines: 9;
    columns: 1;
    spacing: 5px;
}

element {
    padding: 8px 12px;
    spacing: 14px;
}

element-icon {
    size: 46px;
    border-radius: 8px;
}

element-text {
    font: "JetBrainsMono Nerd Font 12";
}

entry {
    placeholder: "search the clipboard…";
}

prompt {
    text-color: @accent;
    font: "JetBrainsMono Nerd Font 13";
}
