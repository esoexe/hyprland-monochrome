# Keep the config files tidy no matter which editor you use.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{sh,jsonc,rasi,conf,ini,toml}]
indent_size = 4

[*.{md,yml,yaml}]
indent_size = 2
trim_trailing_whitespace = false

[*.lua]
indent_size = 4
max_line_length = 110

[*.sh]
indent_size = 4
switch_case_indent = true

[Makefile]
indent_style = tab
