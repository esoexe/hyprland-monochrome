      "black": "#141414",
      "red": "#9a9a9a",
      "green": "#b0b0b0",
      "yellow": "#c4c4c4",
      "blue": "#8a8a8a",
      "purple": "#a8a8a8",
      "cyan": "#bdbdbd",
      "white": "#d6d6d6",
      "brightBlack": "#4a4a4a",
      "brightRed": "#c8c8c8",
      "brightGreen": "#d2d2d2",
      "brightYellow": "#dedede",
      "brightBlue": "#bcbcbc",
      "brightPurple": "#cccccc",
      "brightCyan": "#dadada",
      "brightWhite": "#ffffff"
    }
